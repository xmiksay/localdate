DATABASE_URL=postgres://localdate:localdate@localhost/localdate
# Server-level URL; integration tests create and drop localdate_test_<uuid> databases through it.
TEST_DATABASE_URL=postgres://localdate:localdate@localhost/postgres
JWT_SECRET=change-me-to-32-plus-random-bytes-please
# Photo files: `disk` (default, PHOTO_DIR) or `s3` (an S3-compatible bucket, e.g. Garage).
PHOTO_STORAGE=disk
PHOTO_DIR=./data/photos
# Required with PHOTO_STORAGE=s3 (names match Garage's `make bucket` Secret); path-style addressing.
#S3_ENDPOINT=http://localhost:3900
#S3_REGION=garage
#S3_BUCKET=localdate
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
BIND_ADDR=127.0.0.1:3000
# Optional (default 300): how often the background job purges expired windows, waves and refresh tokens.
CLEANUP_INTERVAL_SECS=300
RUST_LOG=info,sqlx=warn,localdate_api=debug
# Optional (default false): rate-limit login/register on the first X-Forwarded-For entry instead of
# the peer IP. Only behind a proxy that overwrites the header (ingress-nginx default); true in k8s.
TRUST_PROXY_HEADERS=false
# Email magic link (optional). Without SMTP_URL and EMAIL_DEV_LOG email is off (503 email_disabled).
# Origin of the PWA; mailed links point at its /auth/email routes.
APP_BASE_URL=http://localhost:5173
# lettre SMTP URL with credentials, e.g. smtps://user:pass@smtp.example.com:465; needs EMAIL_FROM.
#SMTP_URL=
#EMAIL_FROM=localdate <noreply@example.com>
# Dev only: log the mail (incl. the login link) at INFO instead of sending. Refused by release builds.
EMAIL_DEV_LOG=true
# Optional: Sign in with Google (OAuth client of type "Web application", see docs/deployment.md).
# Both or neither; the authorized redirect URI is {APP_BASE_URL}/api/auth/oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Sign in with Telegram (BotFather → bot → Login Widget gives the client id/secret; add
# {APP_BASE_URL}/api/auth/oauth/telegram/callback to its Allowed URLs). Both or neither.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Optional: the bot's token (BotFather) for password-reset links by Telegram message; unset = email only.
TELEGRAM_BOT_TOKEN=
# Optional: Facebook login (+ optional profile picture import), see docs/deployment.md. Both or
# neither; Valid OAuth Redirect URI: {APP_BASE_URL}/api/auth/oauth/facebook/callback.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional: Web Push. Without both keys push is off (GET /api/push/config says enabled: false).
# Generate with `make vapid-keys`; the subject is a mailto: or https:// contact for push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://localdate.mmik.cz
