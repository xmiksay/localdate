DATABASE_URL=postgres://localdate:localdate@localhost/localdate
# Server-level URL; integration tests create and drop localdate_test_<uuid> databases through it.
TEST_DATABASE_URL=postgres://localdate:localdate@localhost/postgres
JWT_SECRET=change-me-to-32-plus-random-bytes-please
PHOTO_DIR=./data/photos
BIND_ADDR=127.0.0.1:3000
# Optional (default 300): how often the background job purges expired windows, waves and refresh tokens.
CLEANUP_INTERVAL_SECS=300
RUST_LOG=info,sqlx=warn,localdate_api=debug
# Optional (default false): rate-limit login/register on the first X-Forwarded-For entry instead of
# the peer IP. Only behind a proxy that overwrites the header (ingress-nginx default); true in k8s.
TRUST_PROXY_HEADERS=false
